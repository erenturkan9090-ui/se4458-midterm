# Billing API
DATABASE_URL=postgresql://billing:billing@localhost:5432/billing
JWT_SECRET=change-me
PORT=3000

# MCP server
# Optional: when set, /mcp requires header x-api-key
MCP_API_KEY=

# Agent
# LLM provider: gemini (free tier, the default when only GEMINI_API_KEY is set) or claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
# Gateway URL incl. version prefix: local gateway (npm run dev -w gateway) or the Azure APIM URL
GATEWAY_BASE_URL=http://localhost:8000/billing/v1
# Azure APIM subscription key (sent as Ocp-Apim-Subscription-Key), if the API product requires one
GATEWAY_SUBSCRIPTION_KEY=
MCP_SERVER_URL=http://localhost:4000/mcp
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Optional: skip the login prompt
AGENT_USERNAME=
AGENT_PASSWORD=

# Local gateway (gateway/)
UPSTREAM_URL=http://localhost:3000
RATE_LIMIT=100
RATE_LIMIT_WINDOW_MS=60000
# JWT_SECRET (above) is also used by the gateway to validate tokens on protected routes
